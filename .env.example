# comp[AI]on — environment configuration
# Copy this file to .env and adjust values as needed.

# Backend server port (default: 8765)
COMPANION_BACKEND_PORT=8765

# Frontend dev server port (default: 6769)
COMPANION_FRONTEND_PORT=6769

# SQLite database path (default: backend/database.db, relative to backend/)
# COMPANION_DB_PATH=/absolute/path/to/database.db

# Timezone for the scheduler (default: system local timezone)
# COMPANION_TIMEZONE=Europe/Berlin

# Hermes Agent data root for usage sync (default: %LOCALAPPDATA%/hermes on
# Windows, ~/.hermes elsewhere)
# COMPANION_HERMES_HOME=C:\Users\<you>\AppData\Local\hermes
